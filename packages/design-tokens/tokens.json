{
  "version": 3,
  "status": "implemented",
  "character": "Officiating and broadcast. See docs/architecture/decisions/005-officiating-character.md",
  "typography": {
    "display": "\"Big Shoulders Variable\", \"Arial Narrow\", \"Liberation Sans Narrow\", sans-serif",
