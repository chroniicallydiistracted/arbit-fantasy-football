{
  "name": "@arbit/web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/icons.mjs && node ../../scripts/web/tokens.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:browser": "playwright test",
    "lint": "biome check src tests vite.config.ts playwright.config.ts",
    "format": "biome check --write src tests vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "@tanstack/react-query": "5.105.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "vitest": "5.0.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.3",
    "@biomejs/biome": "2.6.4",
    "@resvg/resvg-js": "2.6.2"
  }
}
