{
  "version": 1,
  "commands": {
    "foundation": [
      "python",
      "scripts/validate_foundation.py"
    ],
    "governance": [
      "python",
      "scripts/governance.py",
      "doctor"
    ],
    "governance-tests": [
      "python",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tests/governance",
      "-p",
      "test_*.py"
    ],
    "web-check": [
      "make",
      "web-check"
    ],
    "runtime-check": [
      "make",
      "runtime-check"
    ],
    "model-tests": [
      "uv",
      "run",
      "pytest",
      "libs/arbit-model/tests"
    ],
    "point-in-time": [
      "uv",
      "run",
      "pytest",
      "libs/arbit-data/tests/test_nfl_availability.py",
      "tests/integration/test_nflverse_provenance.py"
    ],
    "provenance": [
      "uv",
      "run",
      "pytest",
      "tests/integration/test_nflverse_provenance.py"
    ],
    "live-replay": [
      "uv",
      "run",
      "pytest",
      "libs/arbit-data/tests/test_live_actions.py",
      "libs/arbit-data/tests/test_live_motion.py"
    ]
  }
}
