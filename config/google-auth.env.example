# Copy to ignored .env.auth.local with permissions 600. Never commit populated values.
# Used after .env.local; this file does not contain the database URL or operator token.
ARBIT_ENV=development
ARBIT_AUTH_MODE=oidc
ARBIT_PUBLIC_ORIGIN=http://127.0.0.1:8000
ARBIT_OIDC_ISSUER=https://accounts.google.com
ARBIT_OIDC_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
ARBIT_OIDC_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
ARBIT_OIDC_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
ARBIT_OIDC_ALLOWED_HOSTS='["accounts.google.com","oauth2.googleapis.com","www.googleapis.com"]'
ARBIT_OIDC_CLIENT_ID=
ARBIT_OIDC_CLIENT_SECRET=
