[Unit]
Description=Run the M3-3 DvP prospective sweep every six hours during the 2026 research window

[Timer]
# Week W-1's last results count from Tuesday 12:00 UTC; week W's first kickoff is usually Thursday
# about 01:15 UTC. The 00:17 run falls inside the PC's daily 00:10-00:35 UTC wake window
# (infra/windows/arbit-wake.ps1); a run missed while the PC slept fires at the next wake
# (Persistent). The calendar ends after week 18's cutoff, and the sweep disables this timer
# itself once every week is final and every commitment verified.
OnCalendar=2026-11,12-* 00/6:17:00 UTC
OnCalendar=2027-01-01..15 00/6:17:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
