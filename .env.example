# Local development settings; commands read their applicable variables.
# Use config/league.json for owner-confirmed league and season.
# Populate real secrets only in an ignored local file or secret store.
ARBIT_ENV=development
ARBIT_DATABASE_URL=
ARBIT_STORAGE_PATH=
ARBIT_ESPN_S2=
ARBIT_ESPN_SWID=
ARBIT_OIDC_ISSUER=
ARBIT_OIDC_CLIENT_ID=
ARBIT_OIDC_CLIENT_SECRET=
ARBIT_PUBLIC_ORIGIN=

# Optional development-only operator reads (32..128 URL-safe characters).
# Generate a private ignored profile with make local-env; leave blank here.
# ARBIT_OPERATOR_TOKEN=
# ARBIT_STORAGE_PATH=data/source-archives
# ARBIT_NFLVERSE_PATH=data/nflverse

# Supplemental/live source objects; default data/public-sources, never a static directory.
# ARBIT_PUBLIC_SOURCES_PATH=data/public-sources
